{
  "name": "bs-sams",
  "main": "server/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bs-sams",
      "database_id": "8ea1d093-ec9e-4770-8132-f110bb0bb7fa",
      "migrations_dir": "migrations",
    },
  ],
}
