{
  "name": "bs-sams",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "wrangler dev --ip 0.0.0.0",
    "db:migrate": "wrangler d1 migrations apply bs-sams --local",
    "test": "node --test tests/*.test.js",
    "bootstrap": "node scripts/bootstrap.js",
    "test:integration": "node tests/integration.mjs",
    "format": "prettier --write src server scripts tests docs README.md *.js *.json *.jsonc",
    "format:check": "prettier --check src server scripts tests docs README.md *.js *.json *.jsonc"
  },
  "dependencies": {
    "@fontsource/sarabun": "^5.2.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "pdfmake": "^0.2.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.10",
    "vite": "^6.3.0",
    "wrangler": "^4.0.0"
  }
}
